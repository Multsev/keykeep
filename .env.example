# OAuth token with write access to the selected Yandex Disk folder.
YANDEX_DISK_TOKEN=
YANDEX_DISK_FOLDER=KeyKeep/releases

# Public client ID of the Yandex OAuth application used by KeyKeep.
YANDEX_OAUTH_CLIENT_ID=

# Android signing credentials. Use an absolute path outside this repository.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
NFS_RELEASE_PATH=
