# Maintainer-only: OAuth token with write access to the Yandex Disk folder
# that stores APK releases. Do not put this value in an APK or commit it.
YANDEX_DISK_TOKEN=
YANDEX_DISK_FOLDER=KeyKeep/releases

# Public OAuth Client ID used by the Android app at build time. This is not a
# secret; each published app should use its own Yandex OAuth application.
YANDEX_OAUTH_CLIENT_ID=
